package = "inboxcabin"
version = "1.0.0-1"
source = {
   url = "git+https://gitea.com/inboxcabin/inboxcabin.git"
}
description = {
   summary = "Inbox Cabin: manage multiple email inboxes in one simple to use Windows desktop app.",
   detailed = "Project listing for Inbox Cabin, a Windows desktop app for managing multiple email inboxes in one place. Learn more at https://inboxcabin.com",
   homepage = "https://inboxcabin.com",
   license = "MIT"
}
dependencies = {
   "lua >= 5.1"
}
build = {
   type = "none"
}
