package = "glance-widgets-api-sdk"
version = "1.0.0-1"
source = {
  url = "file://glance-widgets-api-sdk-1.0.0.tar.gz",
  dir = "glance-widgets-api-sdk-1.0.0",
}
description = { summary = "SDK for generating Glance Widgets API responses", license = "MIT" }
dependencies = { "lua >= 5.4", "lua-cjson >= 2.1" }
build = { type = "builtin", copy_directories = { "licenses" }, modules = {
  ["glance_widgets_native.crypto"] = "src/glance_widgets_native/crypto.lua",
  ["glance_widgets"] = "src/glance_widgets.lua",
  ["glance_widgets_native.box"] = "src/glance_widgets_native/box.lua",
  ["glance_widgets_native.color"] = "src/glance_widgets_native/color.lua",
  ["glance_widgets_native.components.bar-chart"] = "src/glance_widgets_native/components/bar-chart.lua",
  ["glance_widgets_native.components.heatmap"] = "src/glance_widgets_native/components/heatmap.lua",
  ["glance_widgets_native.components.line-chart"] = "src/glance_widgets_native/components/line-chart.lua",
  ["glance_widgets_native.components.pixel-fit"] = "src/glance_widgets_native/components/pixel-fit.lua",
  ["glance_widgets_native.components.pixel-text"] = "src/glance_widgets_native/components/pixel-text.lua",
  ["glance_widgets_native.components.progress-bar"] = "src/glance_widgets_native/components/progress-bar.lua",
  ["glance_widgets_native.components.ring-progress"] = "src/glance_widgets_native/components/ring-progress.lua",
  ["glance_widgets_native.components.battery"] = "src/glance_widgets_native/components/battery.lua",
  ["glance_widgets_native.components.modern"] = "src/glance_widgets_native/components/modern.lua",
  ["glance_widgets_native.components.pixel-bar-chart"] = "src/glance_widgets_native/components/pixel-bar-chart.lua",
  ["glance_widgets_native.components.pixel-progress-bar"] = "src/glance_widgets_native/components/pixel-progress-bar.lua",
  ["glance_widgets_native.components.pixel-ring-progress"] = "src/glance_widgets_native/components/pixel-ring-progress.lua",
  ["glance_widgets_native.components.signal"] = "src/glance_widgets_native/components/signal.lua",
  ["glance_widgets_native.components.shared"] = "src/glance_widgets_native/components/shared.lua",
  ["glance_widgets_native.components.stat"] = "src/glance_widgets_native/components/stat.lua",
  ["glance_widgets_native.components.status-strip"] = "src/glance_widgets_native/components/status-strip.lua",
  ["glance_widgets_native.font"] = "src/glance_widgets_native/font.lua",
  ["glance_widgets_native.generated.font-data"] = "src/glance_widgets_native/generated/font-data.lua",
  ["glance_widgets_native.generated.icon-data"] = "src/glance_widgets_native/generated/icon-data.lua",
  ["glance_widgets_native.geometry"] = "src/glance_widgets_native/geometry.lua",
  ["glance_widgets_native.icons"] = "src/glance_widgets_native/icons.lua",
  ["glance_widgets_native.index"] = "src/glance_widgets_native/index.lua",
  ["glance_widgets_native.layers"] = "src/glance_widgets_native/layers.lua",
  ["glance_widgets_native.lualib_bundle"] = "src/glance_widgets_native/lualib_bundle.lua",
  ["glance_widgets_native.matrix"] = "src/glance_widgets_native/matrix.lua",
  ["glance_widgets_native.output"] = "src/glance_widgets_native/output.lua",
  ["glance_widgets_native.pixelate"] = "src/glance_widgets_native/pixelate.lua",
  ["glance_widgets_native.protocol.constants"] = "src/glance_widgets_native/protocol/constants.lua",
  ["glance_widgets_native.protocol.types"] = "src/glance_widgets_native/protocol/types.lua",
  ["glance_widgets_native.protocol.validate"] = "src/glance_widgets_native/protocol/validate.lua",
  ["glance_widgets_native.raster"] = "src/glance_widgets_native/raster.lua",
  ["glance_widgets_native.signature"] = "src/glance_widgets_native/signature.lua",
  ["glance_widgets_native.text-matrix"] = "src/glance_widgets_native/text-matrix.lua",
  ["glance_widgets_native.themes"] = "src/glance_widgets_native/themes.lua",
  ["glance_widgets_native.native_support"] = "src/glance_widgets_native/native_support.lua",
} }
