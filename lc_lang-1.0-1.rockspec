package = "lc_lang"
version = "1.0-1"
source = {
   url = "git+https://github.com/Lemon-Enterprise/lc_lang.git",
   tag = "v1.0.0"
}
description = {
   summary = "Lemon Code (LC-lang) é uma linguagem experimental escrita inteiramente em **Lua**.",
   detailed = [[
Lemon Code (LC-lang) é uma linguagem experimental escrita inteiramente em **Lua**. O repositório e deliberadamente modular: compilador, AST, análise semântica, runtime, Lemon Studio, backends, formatter, LSP e testes ficam em módulos independentes.
]],
   homepage = "https://github.com/Lemon-Enterprise/lc_lang",
   license = "Apache-2.0"
}
dependencies = {
   "lua >= 5.1, < 5.2"
}
