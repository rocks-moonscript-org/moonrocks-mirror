    type = 'builtin',
    modules = {
        ['ai.debugbridge.bsp'] = 'lua/ai/debugbridge/bsp.lua',
        ['dev'] = 'lua/dev/init.lua',
        ['dev.ansible'] = 'lua/dev/ansible.lua',
