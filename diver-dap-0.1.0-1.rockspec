package = 'diver-dap'
version = '0.1.0-1'
source = {
    url = 'git+https://github.com/qompassai/luarocks.git',
    dir = 'luarocks/dap',
}
description = {
    summary = 'Diver debug-adapter suite: dap.* session engine, adapters, store, lifecycle and integrations (Moonwalk, phlow).',
    homepage = 'https://github.com/qompassai/luarocks',
    license = 'Apache-2.0',
}
dependencies = {
    'lua >= 5.1',
}
build = {
    type = 'builtin',
    modules = {
        ['dap'] = 'lua/dap/init.lua',
        ['dap._cmds'] = 'lua/dap/_cmds.lua',
        ['dap.adapters.moonwalk'] = 'lua/dap/adapters/moonwalk.lua',
        ['dap.android'] = 'lua/dap/android.lua',
        ['dap.ansible'] = 'lua/dap/ansible.lua',
        ['dap.apex'] = 'lua/dap/apex.lua',
        ['dap.async'] = 'lua/dap/async.lua',
        ['dap.backend'] = 'lua/dap/backend.lua',
        ['dap.bash'] = 'lua/dap/bash.lua',
        ['dap.breakpoints'] = 'lua/dap/breakpoints.lua',
        ['dap.cobol'] = 'lua/dap/cobol.lua',
        ['dap.cortex-debug'] = 'lua/dap/cortex-debug.lua',
        ['dap.csharp'] = 'lua/dap/csharp.lua',
        ['dap.dap'] = 'lua/dap/dap.lua',
        ['dap.dart'] = 'lua/dap/dart.lua',
        ['dap.elixir'] = 'lua/dap/elixir.lua',
        ['dap.entity'] = 'lua/dap/entity.lua',
        ['dap.erlang'] = 'lua/dap/erlang.lua',
        ['dap.ext.autocompl'] = 'lua/dap/ext/autocompl.lua',
        ['dap.ext.vscode'] = 'lua/dap/ext/vscode.lua',
        ['dap.firefox'] = 'lua/dap/firefox.lua',
        ['dap.gdb'] = 'lua/dap/gdb.lua',
        ['dap.go'] = 'lua/dap/go.lua',
        ['dap.godot'] = 'lua/dap/godot.lua',
        ['dap.haskell'] = 'lua/dap/haskell.lua',
        ['dap.integrations.moonwalk'] = 'lua/dap/integrations/moonwalk.lua',
        ['dap.integrations.phlow'] = 'lua/dap/integrations/phlow.lua',
        ['dap.java'] = 'lua/dap/java.lua',
        ['dap.kotlin'] = 'lua/dap/kotlin.lua',
        ['dap.lifecycle'] = 'lua/dap/lifecycle.lua',
        ['dap.lldb'] = 'lua/dap/lldb.lua',
        ['dap.lldb-dap'] = 'lua/dap/lldb-dap.lua',
        ['dap.log'] = 'lua/dap/log.lua',
        ['dap.lua'] = 'lua/dap/lua.lua',
        ['dap.mojo'] = 'lua/dap/mojo.lua',
        ['dap.nix'] = 'lua/dap/nix.lua',
        ['dap.node'] = 'lua/dap/node.lua',
        ['dap.ocaml'] = 'lua/dap/ocaml.lua',
        ['dap.perl'] = 'lua/dap/perl.lua',
        ['dap.php'] = 'lua/dap/php.lua',
        ['dap.postgres'] = 'lua/dap/postgres.lua',
        ['dap.powershell'] = 'lua/dap/powershell.lua',
        ['dap.probe-rs'] = 'lua/dap/probe-rs.lua',
        ['dap.progress'] = 'lua/dap/progress.lua',
        ['dap.protocol'] = 'lua/dap/protocol.lua',
        ['dap.python'] = 'lua/dap/python.lua',
        ['dap.r'] = 'lua/dap/r.lua',
        ['dap.registry'] = 'lua/dap/registry/init.lua',
        ['dap.registry.discovery'] = 'lua/dap/registry/discovery.lua',
        ['dap.renderdoc'] = 'lua/dap/renderdoc.lua',
        ['dap.repl'] = 'lua/dap/repl.lua',
        ['dap.rpc'] = 'lua/dap/rpc.lua',
        ['dap.ruby'] = 'lua/dap/ruby.lua',
        ['dap.rust'] = 'lua/dap/rust.lua',
        ['dap.scala'] = 'lua/dap/scala.lua',
        ['dap.session'] = 'lua/dap/session.lua',
        ['dap.sql'] = 'lua/dap/sql.lua',
        ['dap.sqlite'] = 'lua/dap/sqlite.lua',
        ['dap.store'] = 'lua/dap/store/init.lua',
        ['dap.store.common'] = 'lua/dap/store/common.lua',
        ['dap.store.postgresql'] = 'lua/dap/store/postgresql.lua',
        ['dap.store.schema'] = 'lua/dap/store/schema.lua',
        ['dap.store.sqlite'] = 'lua/dap/store/sqlite.lua',
        ['dap.ui'] = 'lua/dap/ui.lua',
        ['dap.ui.widgets'] = 'lua/dap/ui/widgets.lua',
        ['dap.unity'] = 'lua/dap/unity.lua',
        ['dap.unreal'] = 'lua/dap/unreal.lua',
        ['dap.utils'] = 'lua/dap/utils.lua',
        ['dap.zig'] = 'lua/dap/zig.lua'
    }
}
