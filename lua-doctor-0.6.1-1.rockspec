rockspec_format = "3.0"
package = "lua-doctor"
version = "0.6.1-1"
source = {
   url = "https://github.com/doctor-labs/lua-doctor/releases/download/v0.6.1/lua-doctor-0.6.1.tar.gz",
   dir = "lua-doctor-0.6.1",
}
description = {
   summary = "Static security scanner for Lua in embedded firmware: finds remote code execution.",
   detailed = [[
lua-doctor finds untrusted data reaching command execution, dynamic code loading and
firmware-specific sinks in Lua code from routers and IoT devices, and reports it
as plain text, JSON, SARIF or HTML with a 0-100 health score.
]],
   homepage = "https://github.com/doctor-labs/lua-doctor",
   license = "MIT",
   labels = {"security", "static-analysis", "firmware", "sarif"},
}
dependencies = {
   "lua >= 5.3",
}
build = {
   type = "builtin",
   modules = {
      ["luadoctor.api"] = "src/luadoctor/api.lua",
      ["luadoctor.bytecode.detect"] = "src/luadoctor/bytecode/detect.lua",
      ["luadoctor.bytecode.header"] = "src/luadoctor/bytecode/header.lua",
      ["luadoctor.bytecode.protos"] = "src/luadoctor/bytecode/protos.lua",
      ["luadoctor.bytecode.triage"] = "src/luadoctor/bytecode/triage.lua",
      ["luadoctor.cli.args"] = "src/luadoctor/cli/args.lua",
      ["luadoctor.cli.baseline"] = "src/luadoctor/cli/baseline.lua",
      ["luadoctor.cli.ci_cmd"] = "src/luadoctor/cli/ci_cmd.lua",
      ["luadoctor.cli.config"] = "src/luadoctor/cli/config.lua",
       ["luadoctor.cli.fix_cmd"] = "src/luadoctor/cli/fix_cmd.lua",
       ["luadoctor.cli.handoff"] = "src/luadoctor/cli/handoff.lua",
      ["luadoctor.cli.install_cmd"] = "src/luadoctor/cli/install_cmd.lua",
      ["luadoctor.cli.mcp_cmd"] = "src/luadoctor/cli/mcp_cmd.lua",
      ["luadoctor.cli.menu"] = "src/luadoctor/cli/menu.lua",
       ["luadoctor.cli.progress"] = "src/luadoctor/cli/progress.lua",
       ["luadoctor.cli.nginxconf"] = "src/luadoctor/cli/nginxconf.lua",
       ["luadoctor.cli.review"] = "src/luadoctor/cli/review.lua",
      ["luadoctor.cli.rules_cmd"] = "src/luadoctor/cli/rules_cmd.lua",
      ["luadoctor.cli.scope"] = "src/luadoctor/cli/scope.lua",
       ["luadoctor.cli.selection"] = "src/luadoctor/cli/selection.lua",
       ["luadoctor.cli.selector"] = "src/luadoctor/cli/selector.lua",
       ["luadoctor.cli.template"] = "src/luadoctor/cli/template.lua",
       ["luadoctor.cli.term"] = "src/luadoctor/cli/term.lua",
      ["luadoctor.cli.walk"] = "src/luadoctor/cli/walk.lua",
      ["luadoctor.cli.why_cmd"] = "src/luadoctor/cli/why_cmd.lua",
      ["luadoctor.engine.callgraph"] = "src/luadoctor/engine/callgraph.lua",
      ["luadoctor.engine.inline_directives"] = "src/luadoctor/engine/inline_directives.lua",
      ["luadoctor.engine.jobs"] = "src/luadoctor/engine/jobs.lua",
      ["luadoctor.engine.interprocedural"] = "src/luadoctor/engine/interprocedural.lua",
      ["luadoctor.engine.escapes"] = "src/luadoctor/engine/escapes.lua",
      ["luadoctor.engine.parse_context"] = "src/luadoctor/engine/parse_context.lua",
      ["luadoctor.engine.pipeline"] = "src/luadoctor/engine/pipeline.lua",
      ["luadoctor.engine.taint"] = "src/luadoctor/engine/taint.lua",
      ["luadoctor.engine.whole_program"] = "src/luadoctor/engine/whole_program.lua",
      ["luadoctor.main"] = "src/luadoctor/main.lua",
      ["luadoctor.registry.platform_api"] = "src/luadoctor/registry/platform_api.lua",
      ["luadoctor.registry.profiles"] = "src/luadoctor/registry/profiles.lua",
      ["luadoctor.registry.stds.cgilua"] = "src/luadoctor/registry/stds/cgilua.lua",
      ["luadoctor.registry.stds.espressif"] = "src/luadoctor/registry/stds/espressif.lua",
      ["luadoctor.registry.stds.hisi"] = "src/luadoctor/registry/stds/hisi.lua",
      ["luadoctor.registry.stds.luajit"] = "src/luadoctor/registry/stds/luajit.lua",
      ["luadoctor.registry.stds.luci"] = "src/luadoctor/registry/stds/luci.lua",
      ["luadoctor.registry.stds.openresty"] = "src/luadoctor/registry/stds/openresty.lua",
      ["luadoctor.registry.stds.openwrt"] = "src/luadoctor/registry/stds/openwrt.lua",
      ["luadoctor.registry.stds.signatures"] = "src/luadoctor/registry/stds/signatures.lua",
      ["luadoctor.report.doctor"] = "src/luadoctor/report/doctor.lua",
      ["luadoctor.report.findings"] = "src/luadoctor/report/findings.lua",
      ["luadoctor.report.html"] = "src/luadoctor/report/html.lua",
      ["luadoctor.report.json"] = "src/luadoctor/report/json.lua",
      ["luadoctor.report.plain"] = "src/luadoctor/report/plain.lua",
      ["luadoctor.report.render"] = "src/luadoctor/report/render.lua",
      ["luadoctor.report.sarif"] = "src/luadoctor/report/sarif.lua",
      ["luadoctor.report.score"] = "src/luadoctor/report/score.lua",
      ["luadoctor.report.summary"] = "src/luadoctor/report/summary.lua",
      ["luadoctor.rules.categories"] = "src/luadoctor/rules/categories.lua",
      ["luadoctor.rules.codes"] = "src/luadoctor/rules/codes.lua",
      ["luadoctor.rules.context"] = "src/luadoctor/rules/context.lua",
      ["luadoctor.rules.degraded"] = "src/luadoctor/rules/degraded.lua",
      ["luadoctor.rules.file_role"] = "src/luadoctor/rules/file_role.lua",
      ["luadoctor.rules.firmware"] = "src/luadoctor/rules/firmware.lua",
      ["luadoctor.rules.payloads"] = "src/luadoctor/rules/payloads.lua",
      ["luadoctor.rules.rawscan"] = "src/luadoctor/rules/rawscan.lua",
      ["luadoctor.rules.registry"] = "src/luadoctor/rules/registry.lua",
      ["luadoctor.rules.secrets"] = "src/luadoctor/rules/secrets.lua",
      ["luadoctor.util.const_eval"] = "src/luadoctor/util/const_eval.lua",
      ["luadoctor.util.uci_cursor"] = "src/luadoctor/util/uci_cursor.lua",
      ["luadoctor.util.util"] = "src/luadoctor/util/util.lua",
      ["luadoctor.validate.child"] = "src/luadoctor/validate/child.lua",
      ["luadoctor.validate.driver"] = "src/luadoctor/validate/driver.lua",
      ["luadoctor.validate.report"] = "src/luadoctor/validate/report.lua",
      ["luadoctor.version"] = "src/luadoctor/version.lua",
      ["luacheck.builtin_standards"] = "vendor/luacheck/builtin_standards/init.lua",
      ["luacheck.builtin_standards.love"] = "vendor/luacheck/builtin_standards/love.lua",
      ["luacheck.builtin_standards.luanti"] = "vendor/luacheck/builtin_standards/luanti.lua",
      ["luacheck.builtin_standards.ngx"] = "vendor/luacheck/builtin_standards/ngx.lua",
      ["luacheck.builtin_standards.playdate"] = "vendor/luacheck/builtin_standards/playdate.lua",
      ["luacheck.cache"] = "vendor/luacheck/cache.lua",
      ["luacheck.check"] = "vendor/luacheck/check.lua",
