      ["luacheck.config"] = "vendor/luacheck/config.lua",
      ["luacheck.core_utils"] = "vendor/luacheck/core_utils.lua",
      ["luacheck.decoder"] = "vendor/luacheck/decoder.lua",
      ["luacheck.expand_rockspec"] = "vendor/luacheck/expand_rockspec.lua",
      ["luacheck.filter"] = "vendor/luacheck/filter.lua",
      ["luacheck.format"] = "vendor/luacheck/format.lua",
      ["luacheck.fs"] = "vendor/luacheck/fs.lua",
      ["luacheck.globbing"] = "vendor/luacheck/globbing.lua",
      ["luacheck"] = "vendor/luacheck/init.lua",
      ["luacheck.lexer"] = "vendor/luacheck/lexer.lua",
      ["luacheck.main"] = "vendor/luacheck/main.lua",
      ["luacheck.multithreading"] = "vendor/luacheck/multithreading.lua",
      ["luacheck.options"] = "vendor/luacheck/options.lua",
      ["luacheck.parser"] = "vendor/luacheck/parser.lua",
      ["luacheck.profiler"] = "vendor/luacheck/profiler.lua",
      ["luacheck.runner"] = "vendor/luacheck/runner.lua",
      ["luacheck.serializer"] = "vendor/luacheck/serializer.lua",
      ["luacheck.stages.detect_bad_whitespace"] = "vendor/luacheck/stages/detect_bad_whitespace.lua",
      ["luacheck.stages.detect_compound_operators"] = "vendor/luacheck/stages/detect_compound_operators.lua",
      ["luacheck.stages.detect_cyclomatic_complexity"] = "vendor/luacheck/stages/detect_cyclomatic_complexity.lua",
      ["luacheck.stages.detect_empty_blocks"] = "vendor/luacheck/stages/detect_empty_blocks.lua",
      ["luacheck.stages.detect_empty_statements"] = "vendor/luacheck/stages/detect_empty_statements.lua",
      ["luacheck.stages.detect_globals"] = "vendor/luacheck/stages/detect_globals.lua",
      ["luacheck.stages.detect_reversed_fornum_loops"] = "vendor/luacheck/stages/detect_reversed_fornum_loops.lua",
      ["luacheck.stages.detect_unbalanced_assignments"] = "vendor/luacheck/stages/detect_unbalanced_assignments.lua",
