      ["luacheck.stages.detect_unused_locals"] = "vendor/luacheck/stages/detect_unused_locals.lua",
      ["luacheck.stages"] = "vendor/luacheck/stages/init.lua",
      ["luacheck.stages.linearize"] = "vendor/luacheck/stages/linearize.lua",
