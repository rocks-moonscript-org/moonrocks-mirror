package = 'diver-games'
version = '0.1.0-1'
source = {
    url = 'git+https://github.com/qompassai/luarocks.git',
    dir = 'luarocks/games',
}
description = {
    summary = 'Diver game-engine tooling: games.* for Aseprite, Blender, Godot, LÖVE, Redot, TIC-80, Unity, Unreal and Voidsprite, plus shared character kit.',
    homepage = 'https://github.com/qompassai/luarocks',
    license = 'Apache-2.0',
}
dependencies = {
    'lua >= 5.1',
}
build = {
    type = 'builtin',
    modules = {
        ['games'] = 'lua/games/init.lua',
        ['games.aseprite'] = 'lua/games/aseprite/init.lua',
        ['games.aseprite.actions'] = 'lua/games/aseprite/actions.lua',
