        ['games.robocode.config'] = 'lua/games/robocode/config.lua',
        ['games.robocode.health'] = 'lua/games/robocode/health.lua',
        ['games.shared.async_util'] = 'lua/games/shared/async_util.lua',
        ['games.shared.character'] = 'lua/games/shared/character.lua',
        ['games.shared.events'] = 'lua/games/shared/events.lua',
        ['games.shared.godot_engine'] = 'lua/games/shared/godot_engine.lua',
        ['games.shared.output'] = 'lua/games/shared/output.lua',
        ['games.shared.ui'] = 'lua/games/shared/ui.lua',
