        ['games.aseprite.prompts'] = 'lua/games/aseprite/prompts.lua',
        ['games.aseprite.util'] = 'lua/games/aseprite/util.lua',
        ['games.blender'] = 'lua/games/blender/init.lua',
        ['games.blender.actions'] = 'lua/games/blender/actions.lua',
        ['games.blender.batch'] = 'lua/games/blender/batch.lua',
        ['games.blender.character'] = 'lua/games/blender/character.lua',
        ['games.blender.commands'] = 'lua/games/blender/commands.lua',
        ['games.blender.config'] = 'lua/games/blender/config.lua',
        ['games.blender.export'] = 'lua/games/blender/export.lua',
        ['games.blender.health'] = 'lua/games/blender/health.lua',
        ['games.blender.render'] = 'lua/games/blender/render.lua',
        ['games.blender.sprites'] = 'lua/games/blender/sprites.lua',
        ['games.blender.versions'] = 'lua/games/blender/versions.lua',
        ['games.godot'] = 'lua/games/godot/init.lua',
        ['games.godot.character'] = 'lua/games/godot/character.lua',
        ['games.health'] = 'lua/games/health.lua',
        ['games.love2d'] = 'lua/games/love2d/init.lua',
        ['games.love2d.actions'] = 'lua/games/love2d/actions.lua',
        ['games.love2d.adapters'] = 'lua/games/love2d/adapters/init.lua',
        ['games.love2d.adapters.aseprite'] = 'lua/games/love2d/adapters/aseprite.lua',
        ['games.love2d.adapters.blender'] = 'lua/games/love2d/adapters/blender.lua',
        ['games.love2d.adapters.godot'] = 'lua/games/love2d/adapters/godot.lua',
        ['games.love2d.adapters.redot'] = 'lua/games/love2d/adapters/redot.lua',
