        ['games.love2d.apidefs.love'] = 'lua/games/love2d/apidefs/love.lua',
        ['games.love2d.character'] = 'lua/games/love2d/character.lua',
        ['games.love2d.commands'] = 'lua/games/love2d/commands.lua',
        ['games.love2d.config'] = 'lua/games/love2d/config.lua',
        ['games.love2d.dev'] = 'lua/games/love2d/dev.lua',
        ['games.love2d.health'] = 'lua/games/love2d/health.lua',
        ['games.love2d.libs'] = 'lua/games/love2d/libs.lua',
        ['games.love2d.package'] = 'lua/games/love2d/package.lua',
        ['games.love2d.release'] = 'lua/games/love2d/release.lua',
