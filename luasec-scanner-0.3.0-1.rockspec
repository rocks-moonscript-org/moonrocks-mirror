rockspec_format = "3.0"
package = "luasec-scanner"
version = "0.3.0-1"
source = {
   url = "https://github.com/Vaibhav91one/luasec/releases/download/v0.3.0/luasec-0.3.0.tar.gz",
   dir = "luasec-0.3.0",
}
description = {
   summary = "Static security scanner for Lua in embedded firmware: finds remote code execution.",
   detailed = [[
luasec finds untrusted data reaching command execution, dynamic code loading and
firmware-specific sinks in Lua code from routers and IoT devices, and reports it
as plain text, JSON, SARIF or HTML with a 0-100 health score.
]],
   homepage = "https://github.com/Vaibhav91one/luasec",
   license = "MIT",
   labels = {"security", "static-analysis", "firmware", "sarif"},
}
dependencies = {
   "lua >= 5.3",
}
build = {
   type = "builtin",
   modules = {
      ["luasec.api"] = "src/luasec/api.lua",
      ["luasec.bytecode.detect"] = "src/luasec/bytecode/detect.lua",
      ["luasec.bytecode.header"] = "src/luasec/bytecode/header.lua",
      ["luasec.bytecode.protos"] = "src/luasec/bytecode/protos.lua",
      ["luasec.bytecode.triage"] = "src/luasec/bytecode/triage.lua",
      ["luasec.cli.args"] = "src/luasec/cli/args.lua",
      ["luasec.cli.baseline"] = "src/luasec/cli/baseline.lua",
      ["luasec.cli.ci_cmd"] = "src/luasec/cli/ci_cmd.lua",
      ["luasec.cli.config"] = "src/luasec/cli/config.lua",
       ["luasec.cli.fix_cmd"] = "src/luasec/cli/fix_cmd.lua",
       ["luasec.cli.handoff"] = "src/luasec/cli/handoff.lua",
      ["luasec.cli.install_cmd"] = "src/luasec/cli/install_cmd.lua",
      ["luasec.cli.menu"] = "src/luasec/cli/menu.lua",
       ["luasec.cli.progress"] = "src/luasec/cli/progress.lua",
       ["luasec.cli.review"] = "src/luasec/cli/review.lua",
      ["luasec.cli.rules_cmd"] = "src/luasec/cli/rules_cmd.lua",
      ["luasec.cli.scope"] = "src/luasec/cli/scope.lua",
       ["luasec.cli.selection"] = "src/luasec/cli/selection.lua",
       ["luasec.cli.selector"] = "src/luasec/cli/selector.lua",
       ["luasec.cli.template"] = "src/luasec/cli/template.lua",
       ["luasec.cli.term"] = "src/luasec/cli/term.lua",
      ["luasec.cli.walk"] = "src/luasec/cli/walk.lua",
      ["luasec.cli.why_cmd"] = "src/luasec/cli/why_cmd.lua",
      ["luasec.engine.callgraph"] = "src/luasec/engine/callgraph.lua",
      ["luasec.engine.inline_directives"] = "src/luasec/engine/inline_directives.lua",
      ["luasec.engine.jobs"] = "src/luasec/engine/jobs.lua",
      ["luasec.engine.interprocedural"] = "src/luasec/engine/interprocedural.lua",
      ["luasec.engine.escapes"] = "src/luasec/engine/escapes.lua",
      ["luasec.engine.parse_context"] = "src/luasec/engine/parse_context.lua",
      ["luasec.engine.pipeline"] = "src/luasec/engine/pipeline.lua",
      ["luasec.engine.taint"] = "src/luasec/engine/taint.lua",
      ["luasec.engine.whole_program"] = "src/luasec/engine/whole_program.lua",
      ["luasec.main"] = "src/luasec/main.lua",
      ["luasec.registry.platform_api"] = "src/luasec/registry/platform_api.lua",
      ["luasec.registry.profiles"] = "src/luasec/registry/profiles.lua",
      ["luasec.registry.stds.cgilua"] = "src/luasec/registry/stds/cgilua.lua",
      ["luasec.registry.stds.espressif"] = "src/luasec/registry/stds/espressif.lua",
      ["luasec.registry.stds.hisi"] = "src/luasec/registry/stds/hisi.lua",
      ["luasec.registry.stds.luajit"] = "src/luasec/registry/stds/luajit.lua",
      ["luasec.registry.stds.luci"] = "src/luasec/registry/stds/luci.lua",
      ["luasec.registry.stds.openresty"] = "src/luasec/registry/stds/openresty.lua",
      ["luasec.registry.stds.openwrt"] = "src/luasec/registry/stds/openwrt.lua",
      ["luasec.registry.stds.signatures"] = "src/luasec/registry/stds/signatures.lua",
      ["luasec.report.doctor"] = "src/luasec/report/doctor.lua",
      ["luasec.report.findings"] = "src/luasec/report/findings.lua",
      ["luasec.report.html"] = "src/luasec/report/html.lua",
      ["luasec.report.json"] = "src/luasec/report/json.lua",
      ["luasec.report.plain"] = "src/luasec/report/plain.lua",
      ["luasec.report.render"] = "src/luasec/report/render.lua",
      ["luasec.report.sarif"] = "src/luasec/report/sarif.lua",
      ["luasec.report.score"] = "src/luasec/report/score.lua",
      ["luasec.report.summary"] = "src/luasec/report/summary.lua",
      ["luasec.rules.categories"] = "src/luasec/rules/categories.lua",
      ["luasec.rules.codes"] = "src/luasec/rules/codes.lua",
      ["luasec.rules.context"] = "src/luasec/rules/context.lua",
      ["luasec.rules.degraded"] = "src/luasec/rules/degraded.lua",
      ["luasec.rules.firmware"] = "src/luasec/rules/firmware.lua",
      ["luasec.rules.payloads"] = "src/luasec/rules/payloads.lua",
      ["luasec.rules.rawscan"] = "src/luasec/rules/rawscan.lua",
      ["luasec.rules.registry"] = "src/luasec/rules/registry.lua",
      ["luasec.rules.secrets"] = "src/luasec/rules/secrets.lua",
      ["luasec.util.const_eval"] = "src/luasec/util/const_eval.lua",
      ["luasec.util.util"] = "src/luasec/util/util.lua",
      ["luasec.validate.child"] = "src/luasec/validate/child.lua",
      ["luasec.validate.driver"] = "src/luasec/validate/driver.lua",
      ["luasec.validate.report"] = "src/luasec/validate/report.lua",
      ["luasec.version"] = "src/luasec/version.lua",
      ["luacheck.builtin_standards"] = "vendor/luacheck/builtin_standards/init.lua",
      ["luacheck.builtin_standards.love"] = "vendor/luacheck/builtin_standards/love.lua",
      ["luacheck.builtin_standards.luanti"] = "vendor/luacheck/builtin_standards/luanti.lua",
      ["luacheck.builtin_standards.ngx"] = "vendor/luacheck/builtin_standards/ngx.lua",
      ["luacheck.builtin_standards.playdate"] = "vendor/luacheck/builtin_standards/playdate.lua",
      ["luacheck.cache"] = "vendor/luacheck/cache.lua",
      ["luacheck.check"] = "vendor/luacheck/check.lua",
      ["luacheck.check_state"] = "vendor/luacheck/check_state.lua",
      ["luacheck.config"] = "vendor/luacheck/config.lua",
      ["luacheck.core_utils"] = "vendor/luacheck/core_utils.lua",
      ["luacheck.decoder"] = "vendor/luacheck/decoder.lua",
      ["luacheck.expand_rockspec"] = "vendor/luacheck/expand_rockspec.lua",
      ["luacheck.filter"] = "vendor/luacheck/filter.lua",
      ["luacheck.format"] = "vendor/luacheck/format.lua",
      ["luacheck.fs"] = "vendor/luacheck/fs.lua",
      ["luacheck.globbing"] = "vendor/luacheck/globbing.lua",
      ["luacheck"] = "vendor/luacheck/init.lua",
      ["luacheck.lexer"] = "vendor/luacheck/lexer.lua",
      ["luacheck.main"] = "vendor/luacheck/main.lua",
      ["luacheck.multithreading"] = "vendor/luacheck/multithreading.lua",
      ["luacheck.options"] = "vendor/luacheck/options.lua",
      ["luacheck.parser"] = "vendor/luacheck/parser.lua",
      ["luacheck.profiler"] = "vendor/luacheck/profiler.lua",
      ["luacheck.runner"] = "vendor/luacheck/runner.lua",
      ["luacheck.serializer"] = "vendor/luacheck/serializer.lua",
      ["luacheck.stages.detect_bad_whitespace"] = "vendor/luacheck/stages/detect_bad_whitespace.lua",
      ["luacheck.stages.detect_compound_operators"] = "vendor/luacheck/stages/detect_compound_operators.lua",
      ["luacheck.stages.detect_cyclomatic_complexity"] = "vendor/luacheck/stages/detect_cyclomatic_complexity.lua",
      ["luacheck.stages.detect_empty_blocks"] = "vendor/luacheck/stages/detect_empty_blocks.lua",
      ["luacheck.stages.detect_empty_statements"] = "vendor/luacheck/stages/detect_empty_statements.lua",
      ["luacheck.stages.detect_globals"] = "vendor/luacheck/stages/detect_globals.lua",
      ["luacheck.stages.detect_reversed_fornum_loops"] = "vendor/luacheck/stages/detect_reversed_fornum_loops.lua",
      ["luacheck.stages.detect_unbalanced_assignments"] = "vendor/luacheck/stages/detect_unbalanced_assignments.lua",
      ["luacheck.stages.detect_uninit_accesses"] = "vendor/luacheck/stages/detect_uninit_accesses.lua",
